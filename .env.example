# Copie para .env (nunca commitado) e preencha com os valores reais.
# Usado tanto por dev_server.py (testar api/state.py localmente) quanto por
# scripts/sync_cronograma.py (sincronizar a planilha com o Supabase).

# Dashboard do Supabase → Settings → API. USE A CHAVE service_role, NUNCA a
# chave "anon" — service_role é a única que ignora Row Level Security e só
# deve existir aqui (nunca no navegador, nunca commitada).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Só usado por scripts/sync_cronograma.py — caminho de rede onde o
# "Compras BD.xlsx" fica (ex: \\servidor\pasta\Compras BD.xlsx).
CAMINHO_PLANILHA=
