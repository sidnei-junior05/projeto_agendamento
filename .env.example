# Copie para .env (nunca commitado) e preencha com os valores do Redis.
#
# Se o banco foi criado via Vercel (Storage → Upstash for Redis), a própria
# Vercel já gera variáveis com prefixo KV_ — copie os valores de
# KV_REST_API_URL e KV_REST_API_TOKEN para as duas linhas abaixo:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternativamente, se KV_REST_API_URL / KV_REST_API_TOKEN já estiverem
# definidas no ambiente (ex.: via `vercel env pull`), pode deixar as linhas
# acima em branco — o código também aceita esses nomes diretamente.
